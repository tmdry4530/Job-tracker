# ===========================================
# Supabase 설정
# ===========================================
# Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 익명 키 (클라이언트용)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===========================================
# OAuth 설정 (Supabase Dashboard에서 설정)
# ===========================================
# Google OAuth: https://console.cloud.google.com/
# 1. OAuth 2.0 클라이언트 ID 생성
# 2. 승인된 리디렉션 URI: {SUPABASE_URL}/auth/v1/callback
# 3. Supabase Dashboard > Authentication > Providers > Google

# Kakao OAuth: https://developers.kakao.com/
# 1. 애플리케이션 생성 후 REST API 키 확인
# 2. 카카오 로그인 활성화 및 Redirect URI 설정
# 3. Supabase Dashboard > Authentication > Providers > Kakao

# ===========================================
# Claude API 설정
# ===========================================
# Claude API 키 (JD 요약용)
CLAUDE_API_KEY=

# ===========================================
# Sentry 에러 모니터링
# ===========================================
# Sentry DSN (프로젝트 설정에서 확인)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry 조직 및 프로젝트 (소스맵 업로드용)
SENTRY_ORG=
SENTRY_PROJECT=

# Sentry Auth Token (소스맵 업로드용, CI/CD에서 사용)
SENTRY_AUTH_TOKEN=

# ===========================================
# 앱 설정
# ===========================================
# 앱 URL (프로덕션에서는 실제 도메인으로 변경)
NEXT_PUBLIC_APP_URL=http://localhost:3000
