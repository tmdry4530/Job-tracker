# ===========================================
# 필수
# ===========================================
# Railway PostgreSQL 연결 문자열
#  - 배포(Railway 서비스): ${{Postgres.DATABASE_URL}} 참조값 사용 (내부 네트워크)
#  - 로컬 개발/마이그레이션: Postgres 서비스의 DATABASE_PUBLIC_URL
DATABASE_URL=

# Auth.js 세션/토큰 서명 키 (32바이트 이상 랜덤). 생성: openssl rand -base64 32
AUTH_SECRET=

# BYOK 사용자 API 키 암호화 마스터 키 (base64 인코딩 32바이트, 필수)
#   생성: openssl rand -base64 32
#   ⚠️ 이 값을 분실/변경하면 저장된 사용자 API 키를 복호화할 수 없습니다.
ENCRYPTION_KEY=

# ===========================================
# 인증 (Google OAuth)
# ===========================================
# Google Cloud Console > OAuth 2.0 클라이언트 ID
# 승인된 리디렉션 URI: https://<도메인>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 프록시(Railway) 뒤에서 콜백 URL 신뢰
AUTH_TRUST_HOST=true
# 배포 도메인 (예: https://job-tracker-web-production.up.railway.app)
AUTH_URL=

# (선택) Kakao OAuth — https://developers.kakao.com/
# AUTH_KAKAO_ID=
# AUTH_KAKAO_SECRET=

# ===========================================
# 앱 설정
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# 선택 기능
# ===========================================
# LLM (JD 요약 / 면접 질문)은 BYOK(Bring Your Own Key)로 동작합니다.
#   서버에 공유 LLM 키를 두지 않습니다. 각 사용자가 대시보드 설정에서 본인의
#   API 키/모델/엔드포인트를 입력하면 암호화되어 DB에 저장되고, 그 키로만 호출됩니다.
#   기본 엔드포인트: https://api.z.ai/api/anthropic, 기본 모델: glm-4.6
#   (client.ts 상수. 환경변수로 관리하지 않음)

# CLOVA OCR (이미지 기반 JD)
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=

# Sentry (선택)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
