# ===========================================
# 필수
# ===========================================
# Railway PostgreSQL 연결 문자열
#  - 배포(Railway 서비스): ${{Postgres.DATABASE_URL}} 참조값 사용 (내부 네트워크)
#  - 로컬 개발/마이그레이션: Postgres 서비스의 DATABASE_PUBLIC_URL
DATABASE_URL=

# Auth.js 세션/토큰 서명 키 (32바이트 이상 랜덤). 생성: openssl rand -base64 32
AUTH_SECRET=

# ===========================================
# 인증 (Google OAuth)
# ===========================================
# Google Cloud Console > OAuth 2.0 클라이언트 ID
# 승인된 리디렉션 URI: https://<도메인>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 프록시(Railway) 뒤에서 콜백 URL 신뢰
AUTH_TRUST_HOST=true
# 배포 도메인 (예: https://job-tracker-web-production.up.railway.app)
AUTH_URL=

# (선택) Kakao OAuth — https://developers.kakao.com/
# AUTH_KAKAO_ID=
# AUTH_KAKAO_SECRET=

# ===========================================
# 앱 설정
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# 선택 기능
# ===========================================
# Claude API (JD 요약 / 면접 질문)
CLAUDE_API_KEY=
# (선택) 사용할 Claude 모델 ID. 미설정 시 기본값 claude-sonnet-4-6
CLAUDE_MODEL=

# CLOVA OCR (이미지 기반 JD)
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=

# 토스페이먼츠 (구독 결제) — https://developers.tosspayments.com/
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 웹훅 서명 검증용 시크릿 (설정 시 HMAC-SHA256 검증)
TOSS_WEBHOOK_SECRET=

# Sentry (선택)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
